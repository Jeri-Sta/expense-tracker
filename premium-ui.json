{
  "profile": "product-admin",
  "sourceRoots": ["web-app/src"],
  "locale": "pt-BR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {
    "Select/Listbox": "authored",
    "Date": "typed",
    "Form": "authored",
    "Scrollbar": "authored",
    "Toast": "authored",
    "CRUD": "authored"
  },
  "requiredCommands": ["lint", "test", "build"],
  "commands": {
    "lint": "npm --prefix web-app run lint",
    "test": "npm --prefix web-app test -- --watch=false --browsers=ChromeHeadless",
    "build": "npm --prefix web-app run build:prod"
  }
}
